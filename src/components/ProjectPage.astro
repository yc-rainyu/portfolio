---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SourceLines from './SourceLines.astro';
import ProjectLinks from './ProjectLinks.astro';
import Metrics from './Metrics.astro';
import ProjectCover from './ProjectCover.astro';
import ProjectNumber from './ProjectNumber.astro';
import ProjectWashes from './ProjectWashes.astro';
import type { Lang } from '../config/site';
import { homePath, workPath } from '../lib/i18n';
import { formatYears, getCopy, getProjects, type Project } from '../lib/content';

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
const copy = await getCopy(lang);
const { Content, headings } = await render(project.entry);

const overview = copy.work.sections.overview;
const actual = headings.filter((h) => h.depth === 2).map((h) => h.text.trim());
if (actual.some((text) => text !== overview) || actual.length > 1) {
  throw new Error(`src/content/projects/${project.entry.id}.md may only use one second-level heading, "${overview}". Found: ${actual.join(', ')}`);
}

const all = await getProjects(lang);
const position = all.findIndex((p) => p.slug === project.slug);
const number = String(position + 1).padStart(2, '0');
const overlap = project.coverLayout === 'overlap';
const heroProject = project.heroCover ? { ...project, cover: project.heroCover, coverAlt: project.heroCoverAlt, coverStill: undefined } : project;
const prev = all[position - 1];
const next = all[position + 1];
const title = `${project.title} | ${copy.meta.siteName}`;
---

<Base lang={lang} title={title} description={project.summary}>
  <article class="project section--designed" data-scroll-anchor="project" data-scroll-section="project">
    <ProjectWashes />
    <div class="container">
      <SourceLines />
      <p class="project__back">
        <a href={`${homePath(lang)}#index`}>← {copy.work.back}</a>
      </p>

      <header class="project__header" data-cover-layout={project.coverLayout} data-scroll-anchor="project-header">
        <div class="project__intro stack veil" data-scroll-anchor="project-intro" data-scroll-priority="1">
          <p class="label">{copy.work.categories[project.category]}</p>
          <div class="project__ornament"><ProjectNumber index={position} /></div>
          <h1 class="project__title">{project.title}</h1>
          <p class="project__summary">{project.summary}</p>
        </div>
        {overlap && (heroProject.cover ? <a class="project__hero-cover" data-scroll-anchor="project-cover" href={heroProject.cover.src} target="_blank" rel="noopener" aria-label={heroProject.coverAlt ?? project.title}>
          <ProjectCover project={heroProject} number={number} loading="eager" />
        </a> : <div class="project__hero-cover" data-scroll-anchor="project-cover"><ProjectCover project={heroProject} number={number} /></div>)}
        <div class="project__details stack veil" data-scroll-anchor="project-details">
        <dl class="project__meta">
          <div>
            <dt class="label">{copy.work.fields.year}</dt>
            <dd>{formatYears(project)}</dd>
          </div>
          {project.role && (
            <div>
              <dt class="label">{copy.work.fields.role}</dt>
              <dd>{project.role}</dd>
            </div>
          )}
          <div>
            <dt class="label">{copy.work.fields.status}</dt>
            <dd>{copy.work.status[project.status]}</dd>
          </div>
        </dl>
        {
          project.stack.length > 0 && (
            <ul class="chips" aria-label={copy.work.fields.stack}>
              {project.stack.map((tech) => <li class="chip">{tech}</li>)}
            </ul>
          )
        }
        <ProjectLinks project={project} copy={copy} />
        </div>
      </header>

      {
        project.metrics.length > 0 && (
          <div class="project__metrics" data-scroll-anchor="project-metrics">
            <Metrics metrics={project.metrics} label={copy.work.fields.metrics} />
          </div>
        )
      }

      {!overlap && <div class="project__cover" data-scroll-anchor="project-cover">{project.cover ? <a href={project.cover.src} target="_blank" rel="noopener" aria-label={project.coverAlt ?? project.title}><ProjectCover project={project} number={number} fit="contain" /></a> : <ProjectCover project={project} number={number} />}</div>}
      <div class="prose project__body veil" data-scroll-anchor="project-body">
        <Content />
      </div>

      <nav class="project__nav" data-scroll-anchor="project-nav" aria-label={`${copy.work.prev} / ${copy.work.next}`}>
        {
          prev ? (
            <a href={workPath(lang, prev.slug)} rel="prev">
              <span class="label">{copy.work.prev}</span>
              <span>{prev.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="project__nav-next" href={workPath(lang, next.slug)} rel="next">
              <span class="label">{copy.work.next}</span>
              <span>{next.title}</span>
            </a>
          )
        }
      </nav>
    </div>
  </article>
</Base>

<script>
  for (const image of document.querySelectorAll<HTMLImageElement>('.project__body img')) {
    if (image.closest('a')) continue;
    const link = document.createElement('a');
    link.href = image.currentSrc || image.src;
    link.target = '_blank';
    link.rel = 'noopener';
    if (image.alt) link.setAttribute('aria-label', image.alt);
    image.replaceWith(link);
    link.append(image);
  }
</script>

<style>
  .project { padding-block: clamp(2rem, 6vw, 4rem) calc(var(--section-gap) / 2); }
  .project::before { content: none; }
  .project__back { margin-bottom: 2rem; }
  .project__back a { display: inline-flex; align-items: center; min-height: var(--hit); font-size: .875rem; }
  .project__header { position: relative; display: grid; gap: 2rem; padding-block: 3rem 1.5rem; }
  .project__intro { position: relative; z-index: 2; isolation: isolate; max-width: 44rem; min-width: 0; }
  .project__title { font-size: clamp(2rem, 4.5vw, 3.75rem); text-wrap: balance; }
  .project__summary { max-width: 38rem; font-size: 1.125rem; color: var(--muted); }
  .project__ornament {
    position: relative; z-index: 0; width: clamp(8rem, 18vw, 15rem); height: clamp(5rem, 12vw, 9rem);
    --number-size: clamp(5rem, 12vw, 9rem); --number-opacity: .8;
    --sprig-width: 56%; --sprig-height: 100%; --sprig-top: -12%; --sprig-right: -6%;
  }
  .project__hero-cover { display: block; min-width: 0; color: inherit; text-decoration: none; }
  .project__hero-cover :global(.project-image) { border: 0; }
  .project__details { position: relative; z-index: 2; isolation: isolate; min-width: 0; }
  .project__meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr)); gap: 1rem 2rem; padding-block: 1.5rem; border-block: 1px solid var(--line); }
  .project__metrics { margin-top: 2rem; padding-block: 2rem; border-bottom: 1px solid var(--line); }
  .project__cover { max-width: 68rem; margin-block: 3rem; padding: 12px; background: var(--card); border: 1px solid var(--line); }
  .project__cover a { display: block; }
  .project__body { position: relative; isolation: isolate; max-width: 44rem; margin-top: 3rem; }
  .project__nav { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .project__nav a { display: grid; gap: .25rem; min-height: var(--hit); padding: 1.5rem; color: var(--ink); text-decoration: none; border: 1px solid var(--line); background: color-mix(in srgb, var(--card) 65%, transparent); }
  .project__nav a:hover { color: var(--accent-text); }
  .project__nav-next { grid-column: 2; text-align: end; }
  @media (min-width: 1024px) {
    .project__header[data-cover-layout='overlap'] { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 0; row-gap: 2.5rem; }
    [data-cover-layout='overlap'] .project__intro { grid-column: 1 / 8; grid-row: 1; padding-block: 1rem; align-self: center; }
    [data-cover-layout='overlap'] .project__hero-cover {
      grid-column: 6 / -1; grid-row: 1; align-self: start; opacity: .7;
      mask-image: linear-gradient(90deg, transparent 0%, #000 36%, #000 95%, transparent 100%);
    }
    [data-cover-layout='overlap'] .project__details { grid-column: 1 / -1; grid-row: 2; }
    .project__hero-cover:focus-visible { mask-image: none; opacity: 1; }
  }
  :global([data-theme='shachiku']) .project__header { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
  :global([data-theme='shachiku']) .project__intro,
  :global([data-theme='shachiku']) .project__hero-cover,
  :global([data-theme='shachiku']) .project__details { grid-column: 1; grid-row: auto; }
  :global([data-theme='shachiku']) .project__hero-cover { max-width: 57rem; margin-top: 0; mask-image: none; opacity: 1; }
  :global([data-theme='shachiku']) .project__ornament { height: 4rem; --number-size: 4rem; --code-number-display: block; }
  :global([data-theme='shachiku']) .project__title::before { content: '# '; color: var(--a); }
  :global([data-theme='shachiku']) .project__body :global(h2)::before { content: '## '; color: var(--a); }
  @media (max-width: 767px) {
    .project__header { padding-top: 3.5rem; gap: 1.5rem; }
    .project__ornament { --sprig-opacity: .4; }
    .project__cover { padding: 6px; margin-block: 2rem; }
    .project__nav, .project__meta { grid-template-columns: minmax(0, 1fr); }
    .project__nav-next { grid-column: 1; }
  }
</style>
