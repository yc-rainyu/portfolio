---
import ProjectNumber from './ProjectNumber.astro';
import ProjectCover from './ProjectCover.astro';
import ProjectLinks from './ProjectLinks.astro';
import Metrics from './Metrics.astro';
import type { Lang } from '../config/site';
import { workPath } from '../lib/i18n';
import { formatYears, type Project, type SiteCopy } from '../lib/content';

interface Props {
  lang: Lang;
  projects: Project[];
  copy: SiteCopy;
}

const { lang, projects, copy } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<ol class="featured">
  {
    projects.map((project, i) => {
      const href = workPath(lang, project.slug);
      return (
        <li class="work" id={`work-${project.slug}`} data-scroll-anchor={`work-${project.slug}`}>
          <div class="work__ornament" aria-hidden="true">
            <ProjectNumber index={i} />
          </div>
          <a class="work__frame" href={href} tabindex="-1" aria-hidden="true">
            <ProjectCover project={project} number={pad(i + 1)} />
          </a>
          <div class="work__text veil">
            <p class="work__meta label">
              <span class="syntax">&lt;!-- </span>
              {copy.work.categories[project.category]} · {formatYears(project)}
              <span class="syntax"> --&gt;</span>
            </p>
            <h3 class="work__title">
              <a href={href}>{project.title}</a>
            </h3>
            <p class="work__summary">{project.summary}</p>
            <Metrics metrics={project.metrics} label={copy.work.fields.metrics} />
            <ul class="chips" aria-label={copy.work.fields.stack}>
              {project.stack.map((tech) => <li class="chip">{tech}</li>)}
            </ul>
            <div class="work__actions">
              <ProjectLinks project={project} copy={copy} />
              <a class="read-more" href={href} data-source={href}>
                {copy.work.readMore}
                <span class="visually-hidden">：{project.title}</span>
              </a>
            </div>
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .featured {
    display: grid;
    gap: clamp(4rem, 9vw, 7.5rem);
  }

  .work {
    display: grid;
    gap: 1.75rem;
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  /* Keep decorative numerals behind the text veil */
  .work { position: relative; isolation: isolate; }
  .work__ornament {
    position: absolute;
    z-index: -2;
    pointer-events: none;
    top: -3.5rem;
    left: 0;
    width: min(64%, 20rem);
    height: 10rem;
  }
  @media (min-width: 768px) {
    .work__ornament { left: auto; right: 0; top: calc(-1.5 * clamp(3.5rem, 8vw, 6.75rem)); width: 38%; height: 15rem; }
    .work:nth-child(even) .work__ornament { left: 0; right: auto; }
    .work:nth-child(even) .work__ornament { --sprig-right: auto; --sprig-left: 35%; --sprig-top: 5%; }
  }
  @media (max-width: 767px) {
    .work__ornament { left: 8%; width: 70%; }
    .work__ornament { --number-size: clamp(8rem, 30vw, 13rem); --sprig-right: 0; --sprig-width: 55%; --sprig-height: 90%; --sprig-top: -5%; --sprig-opacity: .4; }
  }

  .work__frame {
    display: block;
    padding: 12px;
    border: var(--line-width) solid var(--line);
    background: var(--card);
    box-shadow: 0 1.75rem 3rem -2.25rem color-mix(in srgb, var(--deep) 55%, transparent);
    color: inherit;
    text-decoration: none;
  }

  .work__text {
    display: grid;
    gap: 1rem;
    align-content: center;
    min-width: 0;
  }

  .work__title {
    font-size: clamp(1.375rem, 2.6vw, 1.75rem);
    line-height: 1.4;
  }

  .work__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .work__title a:hover {
    color: var(--accent-text);
  }

  .work__summary {
    max-width: 34rem;
  }

  .work__text :global(.metrics) {
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }

  .work__text :global(.metrics__item--long) {
    grid-column: auto;
  }

  .work .work__text :global(.metrics .metrics__item .metrics__value) {
    font-size: 1.5rem;
    white-space: normal;
  }

  .work__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 768px) {
    .work {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 4.5rem);
      align-items: center;
    }

    .work:nth-child(even) .work__frame {
      order: 2;
    }
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 2rem;
    font-size: 0.875rem;
  }

  .read-more::after {
    content: '↗';
  }

  .syntax {
    display: none;
  }

  :global([data-theme='shachiku']) .syntax {
    display: inline;
  }

  :global([data-theme='shachiku']) .work__frame {
    padding: 0;
    box-shadow: none;
  }

  :global([data-theme='shachiku']) .work__text {
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  :global([data-theme='shachiku']) .work__meta {
    letter-spacing: 0.06em;
    text-transform: none;
  }

  :global([data-theme='shachiku']) .work__title {
    font-size: 1.125rem;
  }

  :global([data-theme='shachiku']) .work__title::before {
    content: '## ';
    color: var(--a);
  }

  :global([data-theme='shachiku']) .work__summary::before {
    content: '- ';
    color: var(--a);
  }

  :global([data-theme='shachiku']) .work__text :global(.chips)::before,
  :global([data-theme='shachiku']) .work__text :global(.chips)::after {
    content: none;
  }

  :global([data-theme='shachiku']) .work__text :global(.chip) {
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  :global([data-theme='shachiku']) .work__actions :global(.btn) {
    flex-wrap: nowrap;
    padding: 0.375rem 1.125rem;
    border: var(--line-width) solid var(--line);
    border-radius: 2px;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  :global([data-theme='shachiku']) .work__actions :global(.link-label)::before {
    content: none;
  }

  :global([data-theme='shachiku']) .work__actions :global(.source-url) {
    display: none;
  }

  :global([data-theme='shachiku']) .read-more {
    gap: 0.25rem;
    font-size: 0.9375rem;
  }

  :global([data-theme='shachiku']) .read-more::after {
    content: '→';
  }
</style>
