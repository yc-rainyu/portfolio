---
import SeasonBackdrop from './SeasonBackdrop.astro';
import { site, type Lang } from '../config/site';
import { art, seasons, type Season } from '../lib/season-art';
import type { SiteCopy } from '../lib/content';
import { sections } from '../lib/sections';
import { buildInfo } from '../lib/build-info';

interface Props {
  lang: Lang;
  copy: SiteCopy;
  first?: unknown;
  cvHref?: string;
}

const { copy, cvHref, lang } = Astro.props;
const hero = copy.hero;

interface PaintPiece { name: string; x: number; y: number; w: number; turn: number; opacity?: number }
const paintings: Record<Season, PaintPiece[]> = {
  spring: [
    { name: 'petal-02', x: 80, y: 24, w: 70, turn: 28, opacity: 0.45 },
    { name: 'blossom-02', x: 75, y: 60, w: 53, turn: -20 },
    { name: 'blossom-01', x: 49, y: 77, w: 31, turn: 18 },
    { name: 'petal-01', x: 28, y: 22, w: 18, turn: -35 },
  ],
  summer: [
    { name: 'wave-01', x: 57, y: 90, w: 140, turn: 0, opacity: 0.75 },
    { name: 'maple-04', x: 86, y: 27, w: 67, turn: 145, opacity: 0.6 },
    { name: 'maple-02', x: 71, y: 49, w: 48, turn: -28 },
    { name: 'maple-05', x: 43, y: 76, w: 28, turn: 32 },
  ],
  autumn: [
    { name: 'ginkgo-06', x: 81, y: 32, w: 73, turn: -28, opacity: 0.65 },
    { name: 'ginkgo-02', x: 68, y: 57, w: 58, turn: 24 },
    { name: 'ginkgo-04', x: 42, y: 79, w: 34, turn: -55 },
    { name: 'ginkgo-03', x: 29, y: 23, w: 20, turn: 52 },
  ],
  winter: [
    { name: 'pine-03', x: 99, y: 24, w: 92, turn: -25, opacity: 0.85 },
    { name: 'pine-04', x: 86, y: 76, w: 63, turn: 12 },
    { name: 'pinecone-01', x: 65, y: 78, w: 25, turn: -22 },
  ],
};
const canvases = await Promise.all(seasons.map(async (season) => ({
  season,
  pieces: await Promise.all(paintings[season].map(async (piece) => ({
    ...piece, ...(await art(season, piece.name, piece.w > 60 ? 760 : 480)),
  }))),
})));


interface Token {
  kind: 'keyword' | 'key' | 'string' | 'punct' | 'comment' | 'plain';
  text: string;
  href?: string;
  external?: boolean;
  download?: boolean;
  heading?: boolean;
  label?: string;
}

interface Line {
  indent: number;
  tokens: Token[];
  gap?: boolean;
}

const punct = (text: string): Token => ({ kind: 'punct', text });
const key = (text: string): Token => ({ kind: 'key', text });
const string = (text: string, extra: Partial<Token> = {}): Token => ({ kind: 'string', text, ...extra });
const bare = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const item = (text: string): Line => ({ indent: 2, tokens: [punct("'"), string(text), punct("',")] });
const pair = (name: string, value: Token): Line => ({
  indent: 2,
  tokens: [key(name), punct(": '"), value, punct("',")],
});

const lines: Line[] = [
  { indent: 0, tokens: [{ kind: 'keyword', text: 'const' }, { kind: 'plain', text: ' profile ' }, punct('= {')] },
  { indent: 1, tokens: [{ kind: 'comment', text: `// ${hero.label}` }], gap: true },
  { indent: 1, tokens: [key('name'), punct(': '), string(hero.name, { heading: true })], gap: true },
  { indent: 1, tokens: [key('role'), punct(": '"), string(hero.role), punct("',")] },
  ...(site.showTagline
    ? [{ indent: 1, tokens: [key('motto'), punct(": '"), string(hero.tagline), punct("',")] }]
    : []),
  { indent: 1, tokens: [key('about'), punct(': [')], gap: true },
  ...hero.intro.map(item),
  { indent: 1, tokens: [punct('],')] },
  { indent: 1, tokens: [key('links'), punct(': {')], gap: true },
  pair('work', string('./work.md', { href: '#work', label: hero.actions.work })),
  ...(cvHref
    ? [pair('cv', string(bare(cvHref), { href: cvHref, external: true, label: hero.actions.cv }))]
    : []),
  pair('github', string(bare(site.links.github), { href: site.links.github, external: true })),
  pair('linkedin', string(bare(site.links.linkedin), { href: site.links.linkedin, external: true })),
  { indent: 1, tokens: [punct('},')] },
  { indent: 1, tokens: [key('facts'), punct(': [')], gap: true },
  ...hero.facts.map(item),
  { indent: 1, tokens: [punct('],')] },
  ...(hero.status
    ? [{ indent: 1, tokens: [key('status'), punct(": '"), string(hero.status), punct("',")], gap: true }]
    : []),
  { indent: 0, tokens: [punct('};')] },
];
---

<section class="hero" aria-label={hero.label} data-scroll-anchor="hero" data-scroll-section="hero">
  <SeasonBackdrop />

  <div class="container hero__grid">
    <p class="hero__display hero__season">{hero.display}</p>

    <div class="hero__head hero__season">
      <p class="label">{hero.label}</p>
      <h1 class="hero__name">{hero.name}</h1>
      <p class="hero__role">{hero.role}</p>
    </div>

    <div class="hero__body hero__season">
      {site.showTagline && <p class="hero__tagline">{hero.tagline}</p>}
      <div class="hero__intro">
        {hero.intro.map((line) => <p>{line}</p>)}
      </div>
      <ul class="actions">
        <li><a class="btn btn--primary" href="#work">{hero.actions.work}</a></li>
        {
          cvHref && (
            <li>
              <a class="btn" href={cvHref} target={/^https?:\/\//.test(cvHref) ? '_blank' : undefined} rel="noopener">
                {hero.actions.cv}
              </a>
            </li>
          )
        }
        <li><a class="btn" href={site.links.github} target="_blank" rel="noopener">{hero.actions.github}</a></li>
        <li><a class="btn" href={site.links.linkedin} target="_blank" rel="noopener">{hero.actions.linkedin}</a></li>
      </ul>
      <ul class="hero__facts veil">
        {hero.factsBesideStats.map((fact) => <li>{fact}</li>)}
      </ul>
      {hero.status && <p class="hero__status veil">{hero.status}</p>}
    </div>

    <div class="hero__code hero__shachiku">
      <ol class="code code-lines" data-code-lines>
        {
          lines.map((line, i) => (
            <li class:list={['code__line', { 'code__line--gap': line.gap }]} style={`--indent:${line.indent}`} data-active={i === lines.length - 1 ? '' : undefined}>
              <span class="code__number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {line.tokens.map((token) => {
                const cls = `tok tok--${token.kind}`;
                if (token.heading) return <h1 class="code__heading">{token.text}</h1>;
                if (token.href) {
                  return (
                    <a class={cls} href={token.href} target={/^https?:\/\//.test(token.href) ? '_blank' : undefined} rel={token.external ? 'noopener' : undefined} download={token.download} aria-label={token.label ? `${token.text}（${token.label}）` : undefined}>
                      {token.text}
                    </a>
                  );
                }
                return (
                  <span class={cls} aria-hidden={token.kind === 'punct' ? 'true' : undefined}>
                    {token.text}
                  </span>
                );
              })}
            </li>
          ))
        }
      </ol>
    </div>

    <div class="hero__workspace hero__shachiku" data-reveal>
      <div class="workspace__panel">
        <p class="workspace__title"><span aria-hidden="true">./</span> {hero.label}</p>
        <nav class="workspace__files" aria-label={lang === 'zh' ? '頁面檔案目錄' : 'Page file index'}>
          {sections.map((section) => (
            <a href={`#${section.id}`}>
              <span aria-hidden="true">↳</span>
              <span>{section.file}</span>
              <span class="workspace__arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
        {(buildInfo.branch || buildInfo.commit) && (
          <dl class="workspace__revision">
            {buildInfo.branch && <div><dt>branch</dt><dd>{buildInfo.branch}</dd></div>}
            {buildInfo.commit && <div><dt>commit</dt><dd>{buildInfo.commit}</dd></div>}
          </dl>
        )}
      </div>
      <dl class="workspace__stats">
        {hero.stats.map((stat) => (
          <div class="workspace__stat">
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero__portrait hero__season" data-reveal>
      <div class="hero__painting" aria-hidden="true">
        {canvases.map(({ season, pieces }) => (
          <div class={`hero__canvas hero__canvas--${season}`}>
            {pieces.map((piece) => (
              <span class="hero__paint" style={`--art:${piece.src};--ratio:${piece.ratio};--x:${piece.x}%;--y:${piece.y}%;--w:${piece.w}%;--turn:${piece.turn}deg;--opacity:${piece.opacity ?? 1}`} />
            ))}
          </div>
        ))}
      </div>
      <dl class="hero__stats">
        {hero.stats.map((stat) => (
          <div class="hero__stat">
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <p class="hero__side label hero__season" aria-hidden="true">{hero.sideLabel}</p>
  </div>
</section>

<script>
  import { initCodeLines } from '../lib/code-lines';
  initCodeLines();
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
    overflow-x: clip;
    --hero-floor: 0rem;
  }

  :global([data-theme='winter']) .hero {
    --hero-floor: clamp(4rem, 10vh, 6rem);
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'display head'
      'body body'
      'card card';
    gap: 1.75rem 1.25rem;
    padding-block: 2.5rem calc(4rem + var(--hero-floor));
  }

  .hero__grid > * {
    min-width: 0;
  }

  :global([data-theme='shachiku']) .hero__season,
  :global(html:not([data-theme='shachiku'])) .hero__shachiku {
    display: none;
  }


  .hero__display {
    grid-area: display;
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.12;
    color: var(--ink);
  }

  :global(:lang(zh-Hant-TW)) .hero__display {
    writing-mode: vertical-rl;
    font-size: clamp(2.75rem, 12vw, 6.5rem);
    letter-spacing: 0.14em;
    padding-right: clamp(1rem, 2.4vw, 2.25rem);
    border-right: var(--line-width) solid var(--line);
  }

  :global(:lang(en)) .hero__grid {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'display'
      'head'
      'body'
      'card';
  }

  :global(:lang(en)) .hero__display {
    font-size: clamp(3.25rem, 11vw, 7rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }


  .hero__head {
    grid-area: head;
    display: grid;
    align-content: center;
  }

  .hero__head .label {
    margin-bottom: 1.5rem;
  }

  .hero__name {
    font-size: var(--text-name);
    font-weight: 500;
    line-height: 1.3;
  }

  .hero__role {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--accent-text);
  }

  .hero__body {
    grid-area: body;
    display: grid;
    align-content: start;
    max-width: 38rem;
  }

  .hero__tagline {
    margin-bottom: 1rem;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    color: var(--ink);
  }

  .hero__intro {
    display: grid;
    gap: 0.75rem;
    color: var(--muted);
  }

  .hero__body .actions {
    gap: 0.5rem;
    margin-top: 1.75rem;
  }

  .hero__body .btn {
    padding-inline: 0.9rem;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: var(--line-width) solid var(--line);
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .hero__status {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.6;
  }

  :global(html:not([data-theme='winter'])) :is(.hero__facts, .hero__status).veil::before {
    display: none;
  }


  .hero__portrait {
    grid-area: card;
    position: relative;
    width: min(100%, 30rem);
    justify-self: end;
    margin-bottom: 1.5rem;
    isolation: isolate;
  }

  .hero__painting {
    position: relative;
    height: 25rem;
    border: var(--line-width) solid var(--line);
    padding: 0.625rem;
    background: var(--card);
    overflow: hidden;
  }

  .hero__canvas {
    display: none;
    position: relative;
    height: 100%;
    overflow: hidden;
    background: var(--surface);
  }

  :global([data-theme='spring']) .hero__canvas--spring,
  :global([data-theme='summer']) .hero__canvas--summer,
  :global([data-theme='autumn']) .hero__canvas--autumn,
  :global([data-theme='winter']) .hero__canvas--winter {
    display: block;
  }

  .hero__paint {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    aspect-ratio: var(--ratio);
    background-image: var(--art);
    background-size: contain;
    background-repeat: no-repeat;
    transform: translate(-50%, -50%) rotate(var(--turn));
    opacity: var(--opacity);
  }

  .hero__stats {
    --stat-alpha: 0.5;
    position: absolute;
    top: 2rem;
    left: -1.5rem;
    display: grid;
    gap: 1.5rem;
    width: 11.5rem;
    margin: 0;
  }


  .hero__stat {
    height: 7rem;
    padding: 0.5rem 0.75rem;
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.25rem;
    border: var(--line-width) solid var(--line);
    background: color-mix(in srgb, var(--card) calc(var(--stat-alpha) * 100%), transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .hero__stat dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 3.2vw, 3rem);
    font-weight: 500;
    line-height: 1;
    color: var(--ink);
  }

  .hero__stat dt {
    color: var(--ink);
    font-size: 0.75rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .hero__side {
    display: none;
  }


  .hero__code {
    grid-area: 1 / 1 / 3 / -1;
  }

  :global([data-theme='shachiku']) .hero__grid {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'code' 'card';
  }

  :global([data-theme='shachiku']) .hero__code {
    grid-area: code;
  }

  .hero__workspace {
    --workspace-inset: 1.5rem;
    --workspace-card-width: 9.5rem;
    --workspace-card-height: 6.5rem;
    --workspace-card-gap: 0.875rem;
    --workspace-card-top: 4rem;
    --workspace-overlap: 1.5rem;
    grid-area: card;
    align-self: center;
    width: 100%;
    max-width: 32rem;
    justify-self: center;
    position: relative;
    isolation: isolate;
    font-family: var(--font-mono);
    color: var(--ink);
  }

  .workspace__panel {
    border: var(--line-width) solid var(--line);
    background: var(--surface);
    padding: 1rem 1rem calc(1rem + var(--workspace-overlap));
  }

  .workspace__title {
    padding-bottom: 1rem;
    border-bottom: var(--line-width) solid var(--line);
    font-size: 0.6875rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .workspace__files {
    display: grid;
    margin-block: 0.75rem;
  }

  .workspace__files a {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    padding: 0.5rem 0.25rem;
    color: var(--ink);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .workspace__files a:hover {
    color: var(--accent-text);
    background: var(--bg);
  }

  .workspace__files a:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }

  .workspace__arrow {
    margin-left: auto;
    color: var(--muted);
  }

  .workspace__revision {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-top: 1rem;
    border-top: var(--line-width) solid var(--line);
    font-size: 0.6875rem;
    line-height: 1.6;
  }

  .workspace__revision dt {
    color: var(--muted);
  }

  .workspace__revision dd {
    margin: 0;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .workspace__stats {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.375rem;
    margin: calc(-1 * var(--workspace-overlap)) 0.375rem 0;
  }

  .workspace__stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 0.75rem 0.5rem;
    border: var(--line-width) solid var(--line);
    border-top: 2px solid var(--accent-text);
    background: var(--card);
  }

  .workspace__stat dd {
    margin: 0;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
  }

  .workspace__stat dt {
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .code {
    padding-block: 0.25rem;
    border-inline-start: var(--line-width) solid var(--line);
  }

  .code__line {
    white-space: pre-wrap;
  }

  .tok {
    font: inherit;
  }

  .tok--comment {
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
  }

  .code__heading {
    display: inline;
    font-family: var(--font-mono);
    font-size: var(--text-name);
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink);
    vertical-align: baseline;
  }

  @media (max-width: 767px) {
    .hero__portrait {
      margin-bottom: 0;
    }

    .hero__painting {
      height: 22.5rem;
    }

    .hero__stats {
      position: relative;
      inset: auto;
      width: auto;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.375rem;
      margin: -1rem 0.375rem 0;
    }

    .hero__stat:nth-child(n) {
      position: relative;
      inset: auto;
      transform: none;
      width: auto;
      height: auto;
      justify-content: flex-end;
      padding: 0.625rem 0.375rem;
    }

    .hero__stat dd {
      font-size: 2.25rem;
    }

    .hero__stat dt {
      font-size: 0.6875rem;
      line-height: 1.5;
    }

    :global(html:not([data-theme='shachiku'])) .hero {
      --backdrop-band: 8.5rem;
    }

    :global(html:not([data-theme='shachiku'])) .hero__grid {
      padding-top: calc(var(--backdrop-band) - var(--header-h) + 1rem);
    }
  }


  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: auto minmax(0, 1.15fr) minmax(0, 1fr);
      grid-template-areas:
        'display head card'
        'display body card';
      column-gap: clamp(1.5rem, 3vw, 3rem);
      row-gap: 1.25rem;
      align-content: center;
      min-height: calc(min(56rem, 100svh) - var(--header-h));
      padding-block: 3.5rem calc(6rem + var(--hero-floor));
    }

    .hero__display {
      align-self: start;
    }

    .hero__head {
      align-content: end;
    }

    .hero__portrait {
      align-self: start;
      width: 100%;
      margin-top: 7.8125rem;
    }

    .hero__painting {
      height: 30.3125rem;
    }

    :global(:lang(en)) .hero__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      grid-template-areas:
        'display card'
        'head card'
        'body card';
    }

    :global(:lang(en)) .hero__display {
      align-self: end;
      margin-bottom: 0.75rem;
    }

    :global(html:not([data-theme='shachiku'])) .hero__side {
      display: block;
      position: absolute;
      top: 2rem;
      right: 1rem;
      padding: 0.5rem;
      background: var(--bg);
      transform: rotate(90deg) translateX(100%);
      transform-origin: right top;
      white-space: nowrap;
    }

    :global([data-theme='shachiku']) .hero__grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      grid-template-areas: 'code card';
    }

    .hero__code {
      grid-area: code;
      align-self: center;
    }

    .hero__workspace {
      --workspace-panel-height: 27rem;
      --workspace-content-inset: 9rem;
    }

    .workspace__panel {
      min-height: var(--workspace-panel-height);
      margin-left: var(--workspace-inset);
      padding: 1.25rem 1rem 1.25rem var(--workspace-content-inset);
    }

    .workspace__stats {
      position: absolute;
      top: var(--workspace-card-top);
      left: 0;
      width: var(--workspace-card-width);
      grid-template-columns: minmax(0, 1fr);
      gap: var(--workspace-card-gap);
      margin: 0;
    }

    .workspace__stat {
      min-height: var(--workspace-card-height);
      padding: 0.75rem;
    }

    .workspace__stat dd {
      font-size: 2.5rem;
    }

    .code {
      --code-size: 0.9375rem;
    }
  }
</style>
