---
import FooterSeasons from './FooterSeasons.astro';
import { buildInfo } from '../lib/build-info';
import type { Lang } from '../config/site';
import { htmlLang } from '../lib/i18n';
import type { SiteCopy } from '../lib/content';

interface Props {
  lang: Lang;
  copy: SiteCopy;
}

const { lang, copy } = Astro.props;
const builtAt = buildInfo.builtAt;
const builtLabel = new Intl.DateTimeFormat(htmlLang[lang], {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
  timeZone: 'Asia/Taipei',
  timeZoneName: 'short',
}).format(builtAt);
---

<footer class="site-footer" data-scroll-anchor="footer" data-scroll-section="footer">
  <FooterSeasons />
  <div class="container site-footer__inner">
    <p class="footer-status"><span>branch: {buildInfo.branch}</span><span>{buildInfo.commit}</span><span>{lang.toUpperCase()}</span><span class="footer-theme">Coder</span></p>
    <p>© {builtAt.getFullYear()} {copy.footer.copyright}</p>
    <p>
      <span>{copy.footer.builtAt}</span>{' '}<time datetime={builtAt.toISOString()}>{builtLabel}</time>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--line-width) solid var(--line);
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 2rem;
    padding-block: 2rem;
  }

  .site-footer {
    background: var(--bg);
    margin-top: 3rem;
  }
  .site-footer__inner {
    padding-block: 2.5rem;
  }
  .footer-status {
    display: none;
  }
  :global([data-theme="shachiku"]) .site-footer__inner {
    padding-block: 0.75rem;
    gap: 0.5rem 2rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }
  :global([data-theme="shachiku"]) .footer-status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: var(--ink);
  }
  :global([data-theme="shachiku"]) .footer-theme {
    color: var(--accent-text);
  }
</style>
