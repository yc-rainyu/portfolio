---
import { art, seasons } from '../lib/season-art';

interface Props { index: number }
const { index } = Astro.props;
const numberArt = await Promise.all(seasons.map(async (season) => {
  const names = {
    spring: ['blossom-01', 'branch-01', 'blossom-02'],
    summer: ['maple-04', 'maple-01', 'maple-05'],
    autumn: ['ginkgo-06', 'ginkgo-03', 'ginkgo-01'],
    winter: ['pine-04', 'pine-02', 'pine-05'],
  }[season];
  return { season, images: await Promise.all(names.map(name => art(season, name, 900))) };
}));
---

<div class="number-art" aria-hidden="true">
  {numberArt.map(({ season, images }) => (
    <span class="number-art__season" data-season={season} style={`--fill:${images[index % 3]!.src};--leaf:${images[(index + 1) % 3]!.src};--crop:${20 + (index * 17) % 65}%;--turn:${index % 2 ? -32 : 24}deg`}>
      <span class="number-art__sprig" />
      <span class="number-art__value">{String(index + 1).padStart(2, '0')}</span>
    </span>
  ))}
  <span class="number-art__code">{String(index + 1).padStart(2, '0')}</span>
</div>

<style>
  .number-art { position: relative; width: 100%; height: 100%; pointer-events: none; }
  .number-art__season { display: none; position: absolute; inset: 0; }
  :global([data-theme='spring']) .number-art__season[data-season='spring'],
  :global([data-theme='summer']) .number-art__season[data-season='summer'],
  :global([data-theme='autumn']) .number-art__season[data-season='autumn'],
  :global([data-theme='winter']) .number-art__season[data-season='winter'] { display: block; }
  .number-art__value {
    position: absolute; inset: 0;
    font-family: var(--font-numeral); font-size: var(--number-size, clamp(9rem, 21vw, 18rem));
    font-weight: 900; line-height: .85; letter-spacing: -.065em;
    color: transparent;
    background-image: var(--fill), linear-gradient(var(--a), var(--b));
    background-size: 115% auto, 100% 100%; background-position: var(--crop) center;
    background-repeat: no-repeat; background-clip: text; -webkit-background-clip: text;
    opacity: var(--number-opacity, .8);
  }
  .number-art__sprig {
    position: absolute; width: var(--sprig-width, 65%); height: var(--sprig-height, 135%);
    right: var(--sprig-right, -8%); left: var(--sprig-left, auto); top: var(--sprig-top, -20%);
    background: var(--leaf) center / contain no-repeat;
    transform: rotate(var(--turn)); opacity: var(--sprig-opacity, .6);
  }
  .number-art__code { display: none; }
  :global([data-theme='shachiku']) .number-art__code {
    display: var(--code-number-display, none); font: 400 var(--number-size, 5rem)/1 var(--font-mono); color: var(--a);
  }
</style>
