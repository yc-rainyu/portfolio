---
import type { Project } from '../lib/content';

interface Props {
  metrics: Project['metrics'];
  label: string;
}

const { metrics, label } = Astro.props;
---

{
  metrics.length > 0 && (
    <dl class="metrics" aria-label={label}>
      {metrics.map((m) => (
        <div class:list={["metrics__item", {"metrics__item--long": m.value.length > 10}]}>
          <dt class="metrics__label">{m.label}</dt>
          <dd class="metrics__value">{m.value}</dd>
          {m.note && <dd class="metrics__note">{m.note}</dd>}
        </div>
      ))}
    </dl>
  )
}

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.25rem 2rem;
  }

  .metrics__item {
    display: flex;
    flex-direction: column;
  }

  .metrics__value {
    order: -1;
    font-family: var(--font-label);
    font-size: clamp(1.25rem, 2.5vw, 2.25rem);
    color: var(--ink);
    line-height: 1.3;
    overflow-wrap: normal;
    word-break: normal;
    white-space: nowrap;
  }

  .metrics__item--long { grid-column: 1 / -1; }
  .metrics__item--long .metrics__value { font-size: clamp(1rem, 2.2vw, 1.75rem); }

  .metrics__label {
    font-size: 0.875rem;
  }

  .metrics__note {
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.6;
  }
</style>
