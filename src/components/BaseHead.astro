---
import '@fontsource/jost/latin-400.css';
import '@fontsource/jost/latin-500.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/noto-sans/latin-400.css';
import '@fontsource/noto-sans/latin-500.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { languages, site, storageKeys, themes, type Lang } from '../config/site';
import { hreflang, ogLocale, pathInLang } from '../lib/i18n';
import { publicFileExists } from '../lib/content';
import sansTc400 from '../assets/fonts/generated/noto-sans-tc-400.woff2?url';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  noindex?: boolean;
}

const { title, description, lang, noindex = false } = Astro.props;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site);
const ogImage = publicFileExists(site.ogImage) ? new URL(site.ogImage, Astro.site) : undefined;
const themeInit = { themes: [...themes], key: storageKeys.theme };
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline define:vars={{ themeInit }}>
  (function () {
    var themes = themeInit.themes;
    var key = themeInit.key;
    var root = document.documentElement;
    var valid = function (t) { return themes.indexOf(t) !== -1; };
    var stored = function (name) { try { return window[name].getItem(key); } catch (e) { return null; } };
    var fromUrl = function () { try { return new URLSearchParams(location.search).get('theme'); } catch (e) { return null; } };
    var writeUrl = function (theme) {
      try {
        var params = new URLSearchParams(location.search);
        if (params.get('theme') === theme) return;
        params.set('theme', theme);
        history.replaceState(history.state, '', location.pathname + '?' + params + location.hash);
      } catch (e) {}
    };
    var nav = window.performance && performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
    var back = !!nav && nav.type === 'back_forward';
    var theme = back ? stored('sessionStorage') : fromUrl();
    if (!valid(theme)) theme = back ? fromUrl() : stored('sessionStorage');
    if (!valid(theme)) theme = stored('localStorage');
    if (!valid(theme)) theme = themes[Math.floor(Math.random() * themes.length)];
    try { sessionStorage.setItem(key, theme); } catch (e) {}
    writeUrl(theme);
    root.setAttribute('data-theme', theme);
    root.classList.add('js');
    window.addEventListener('pageshow', function (event) {
      if (!event.persisted) return;
      var current = stored('sessionStorage');
      if (!valid(current)) return;
      writeUrl(current);
      if (current !== root.getAttribute('data-theme')) root.setAttribute('data-theme', current);
    });
  })();
</script>

{lang === 'zh' && <link rel="preload" as="font" type="font/woff2" href={sansTc400} crossorigin />}

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
{
  lang &&
    languages.map((l) => (
      <link rel="alternate" hreflang={hreflang[l]} href={new URL(pathInLang(pathname, l), Astro.site)} />
    ))
}
{lang && <link rel="alternate" hreflang="x-default" href={new URL(pathInLang(pathname, 'en'), Astro.site)} />}

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{lang && <meta property="og:locale" content={ogLocale[lang]} />}
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="630" />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
