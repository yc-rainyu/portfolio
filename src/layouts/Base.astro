---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReadingPosition from '../components/ReadingPosition.astro';
import { site, type Lang } from '../config/site';
import { htmlLang } from '../lib/i18n';
import { getCopy } from '../lib/content';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const copy = await getCopy(lang);
---

<!doctype html>
<html lang={htmlLang[lang]} data-theme={site.defaultTheme}>
  <head>
    <BaseHead lang={lang} title={title} description={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.nav.skip}</a>
    <Header lang={lang} copy={copy} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} copy={copy} />
    <ReadingPosition />
  </body>
</html>
