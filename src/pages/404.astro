---
import BaseHead from '../components/BaseHead.astro';
import SeasonBackdrop from '../components/SeasonBackdrop.astro';
import { site } from '../config/site';
import { getCopy } from '../lib/content';

const zh = await getCopy('zh');
const en = await getCopy('en');
---

<!doctype html>
<html lang="en-GB" data-theme={site.defaultTheme}>
  <head>
    <BaseHead title={`404 | ${en.meta.siteName}`} description={en.notFound.body} noindex />
  </head>
  <body>
    <main class="not-found">
      <SeasonBackdrop />
      <div class="container stack">
        <p class="label">404</p>
        <div class="stack" lang="zh-Hant-TW">
          <h1>{zh.notFound.title}</h1>
          <p>{zh.notFound.body}</p>
          <p><a class="btn" href="/zh/">{zh.notFound.home}</a></p>
        </div>
        <div class="stack" lang="en-GB">
          <h2>{en.notFound.title}</h2>
          <p>{en.notFound.body}</p>
          <p><a class="btn" href="/en/">{en.notFound.home}</a></p>
        </div>
      </div>
    </main>
  </body>
</html>

<style>
  .not-found {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: 100vh;
    padding-block: 4rem;
  }

  @media (max-width: 767px) {
    .not-found {
      --backdrop-band: 9rem;
      padding-top: calc(var(--backdrop-band) + 1rem);
    }
  }

  .not-found .stack + .stack {
    margin-top: 3rem;
  }
</style>
